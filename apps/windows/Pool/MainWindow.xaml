<Window x:Class="Pool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Pool - Creative Pipeline" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Style="{StaticResource WindowStyle}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar -->
        <Border Grid.Column="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="16">
                    <TextBlock Text="Pool"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Creative Pipeline"
                               FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Navigation -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock Text="PROJECTS"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="8,0,0,8"/>

                        <Button Style="{StaticResource SidebarButtonStyle}"
                                Click="OnProjectsClick">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M3,3 L21,3 L21,21 L3,21 Z M5,7 L19,7 M5,11 L19,11 M5,15 L14,15"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2"
                                      Width="20"
                                      Height="20"
                                      Stretch="Uniform"/>
                                <TextBlock Text="All Projects" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButtonStyle}"
                                Click="OnShotsClick">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M4,4 L12,4 L12,12 L4,12 Z M14,4 L22,4 L22,12 L14,12 Z M4,14 L12,14 L12,22 L4,22 Z M14,14 L22,14 L22,22 L14,22 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2"
                                      Width="20"
                                      Height="20"
                                      Stretch="Uniform"/>
                                <TextBlock Text="Shots" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButtonStyle}"
                                Click="OnTimelineClick">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M2,12 L6,12 L6,8 L10,8 L10,16 L14,16 L14,12 L18,12 L18,6 L22,6"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2"
                                      Width="20"
                                      Height="20"
                                      Stretch="Uniform"/>
                                <TextBlock Text="Timeline" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButtonStyle}"
                                Click="OnNodeEditorClick">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M4,4 L12,4 L12,8 L4,8 Z M16,4 L24,4 L24,8 L16,8 Z M8,12 L20,12 M8,12 L4,8 M20,12 L24,8"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2"
                                      Width="20"
                                      Height="20"
                                      Stretch="Uniform"/>
                                <TextBlock Text="Node Editor" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Separator Background="{StaticResource BorderBrush}"
                                   Margin="0,16"/>

                        <TextBlock Text="WORKFLOWS"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="8,0,0,8"/>

                        <Button Style="{StaticResource SidebarButtonStyle}"
                                Click="OnWorkflowsClick">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,2 L22,8 L22,16 L12,22 L2,16 L2,8 Z M12,2 L12,22 M2,8 L22,16 M22,8 L2,16"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2"
                                      Width="20"
                                      Height="20"
                                      Stretch="Uniform"/>
                                <TextBlock Text="Templates" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <Border Grid.Row="2"
                        Background="{StaticResource CardBrush}"
                        Margin="8"
                        CornerRadius="8"
                        Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="32"
                                Height="32"
                                Background="{StaticResource PrimaryBrush}"
                                CornerRadius="16">
                            <TextBlock Text="U"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="User"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Settings"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding CurrentViewTitle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                        <Button Content="New Project"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnNewProjectClick"
                                Margin="0,0,8,0"/>
                        <Button Content="Import"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnImportClick"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" x:Name="ContentArea">
                <!-- Projects View (Default) -->
                <ScrollViewer x:Name="ProjectsView"
                              Visibility="Visible"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Projects}"
                                  Margin="16">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBrush}"
                                        CornerRadius="8"
                                        Width="200"
                                        Height="160"
                                        Margin="8"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="OnProjectClick">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid Margin="16">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Project Thumbnail -->
                                        <Border Grid.Row="0"
                                                Background="{StaticResource SurfaceBrush}"
                                                CornerRadius="4"
                                                Margin="0,0,0,12">
                                            <Path Data="M4,4 L12,4 L12,12 L4,12 Z M14,4 L22,4 L22,12 L14,12 Z M4,14 L12,14 L12,22 L4,22 Z M14,14 L22,14 L22,22 L14,22 Z"
                                                  Stroke="{StaticResource TextMutedBrush}"
                                                  StrokeThickness="2"
                                                  Width="40"
                                                  Height="40"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Project Info -->
                                        <StackPanel Grid.Row="1">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="14"
                                                       FontWeight="Medium"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding ShotCount, StringFormat='{0} shots'}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Timeline View -->
                <Grid x:Name="TimelineView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Timeline Header -->
                    <Border Grid.Row="0"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="|&lt;"
                                    Width="40"
                                    Margin="0,0,4,0"
                                    Click="OnTimelineStart"/>
                            <Button Content="&lt;"
                                    Width="40"
                                    Margin="0,0,4,0"
                                    Click="OnTimelinePrev"/>
                            <Button Content="Play"
                                    Width="60"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="OnTimelinePlay"
                                    Margin="0,0,4,0"/>
                            <Button Content="&gt;"
                                    Width="40"
                                    Margin="0,0,4,0"
                                    Click="OnTimelineNext"/>
                            <Button Content="&gt;|"
                                    Width="40"
                                    Click="OnTimelineEnd"/>

                            <TextBlock Text="Frame: 1 / 100"
                                       VerticalAlignment="Center"
                                       Margin="24,0,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                            <TextBlock Text="24 fps"
                                       VerticalAlignment="Center"
                                       Margin="24,0,0,0"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Timeline Tracks -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="60"/>
                                <RowDefinition Height="60"/>
                                <RowDefinition Height="60"/>
                            </Grid.RowDefinitions>

                            <!-- Track 1 -->
                            <Border Grid.Row="0"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Margin="0,0,0,8">
                                <Grid Margin="12">
                                    <TextBlock Text="Video Track"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <Border Background="{StaticResource PrimaryBrush}"
                                            CornerRadius="4"
                                            Width="200"
                                            Height="40"
                                            HorizontalAlignment="Left"
                                            Margin="100,0,0,0">
                                        <TextBlock Text="Shot_001"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Track 2 -->
                            <Border Grid.Row="1"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Margin="0,0,0,8">
                                <Grid Margin="12">
                                    <TextBlock Text="Audio Track"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <Border Background="#4CAF50"
                                            CornerRadius="4"
                                            Width="350"
                                            Height="40"
                                            HorizontalAlignment="Left"
                                            Margin="50,0,0,0">
                                        <TextBlock Text="Audio_mix.wav"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Track 3 -->
                            <Border Grid.Row="2"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <Grid Margin="12">
                                    <TextBlock Text="Effects Track"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- Node Editor View -->
                <Canvas x:Name="NodeEditorView" Visibility="Collapsed"
                        Background="{StaticResource SurfaceBrush}">
                    <!-- Node 1 -->
                    <Border Canvas.Left="50" Canvas.Top="50"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            BorderThickness="2"
                            CornerRadius="8"
                            Width="180">
                        <StackPanel>
                            <Border Background="{StaticResource PrimaryBrush}"
                                    CornerRadius="6,6,0,0"
                                    Padding="12,8">
                                <TextBlock Text="Input Node"
                                           Foreground="White"
                                           FontWeight="SemiBold"/>
                            </Border>
                            <StackPanel Margin="12">
                                <Grid Margin="0,0,0,8">
                                    <Ellipse Width="12" Height="12"
                                             Fill="{StaticResource AccentBrush}"
                                             HorizontalAlignment="Left"/>
                                    <TextBlock Text="File Path"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="20,0,0,0"/>
                                </Grid>
                            </StackPanel>
                            <Border Background="{StaticResource SurfaceBrush}"
                                    Padding="12,8">
                                <Grid>
                                    <Ellipse Width="12" Height="12"
                                             Fill="{StaticResource PrimaryBrush}"
                                             HorizontalAlignment="Right"/>
                                    <TextBlock Text="Output"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,20,0"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Node 2 -->
                    <Border Canvas.Left="300" Canvas.Top="100"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="#4CAF50"
                            BorderThickness="2"
                            CornerRadius="8"
                            Width="180">
                        <StackPanel>
                            <Border Background="#4CAF50"
                                    CornerRadius="6,6,0,0"
                                    Padding="12,8">
                                <TextBlock Text="Process Node"
                                           Foreground="White"
                                           FontWeight="SemiBold"/>
                            </Border>
                            <StackPanel Margin="12">
                                <Grid Margin="0,0,0,8">
                                    <Ellipse Width="12" Height="12"
                                             Fill="{StaticResource AccentBrush}"
                                             HorizontalAlignment="Left"/>
                                    <TextBlock Text="Input"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="20,0,0,0"/>
                                </Grid>
                                <TextBlock Text="Effect: Blur"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <Border Background="{StaticResource SurfaceBrush}"
                                    Padding="12,8">
                                <Grid>
                                    <Ellipse Width="12" Height="12"
                                             Fill="#4CAF50"
                                             HorizontalAlignment="Right"/>
                                    <TextBlock Text="Output"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,20,0"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Connection Line -->
                    <Line X1="230" Y1="120" X2="300" Y2="150"
                          Stroke="{StaticResource PrimaryBrush}"
                          StrokeThickness="2"/>
                </Canvas>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,8">
                <Grid>
                    <TextBlock Grid.Column="0"
                               Text="Ready"
                               FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding Version, StringFormat='Pool v{0}'}"
                               FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Right Panel - Properties -->
        <Border Grid.Column="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Panel Header -->
                <Border Grid.Row="0"
                        Background="{StaticResource CardBrush}"
                        Padding="16,12">
                    <TextBlock Text="Properties"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </Border>

                <!-- Properties Content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="No selection"
                                   FontSize="14"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,40,0,0"/>

                        <!-- Sample Properties (would be dynamic) -->
                        <TextBlock Text="PROJECT INFO"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,24,0,12"
                                   Visibility="Collapsed"/>

                        <StackPanel Visibility="Collapsed">
                            <TextBlock Text="Name"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBox Text="My Project"
                                     Background="{StaticResource CardBrush}"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     Padding="8"
                                     Margin="0,0,0,16"/>

                            <TextBlock Text="Created"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="2024-01-15"
                                       FontSize="14"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,16"/>

                            <TextBlock Text="Status"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,4"/>
                            <Border Background="#4CAF50"
                                    CornerRadius="4"
                                    Padding="8,4"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="Active"
                                           FontSize="12"
                                           Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
