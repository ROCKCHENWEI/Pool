<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Pool</RootNamespace>
    <AssemblyName>Pool</AssemblyName>
    <ApplicationIcon>Resources\pool.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Authors>Pool Team</Authors>
    <Description>Pool - Creative Pipeline Management Tool</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PoolCore\PoolCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>
</Project>
